#: src/airnef/gui.py:495
msgid "It appears airnefcmd was uncleanly terminated. In the future please press Cancel in the transfer window instead of force-closing it. This allows airnefcmd to perform any necessary cleanup prior to exiting."
msgstr "Có vẻ airnefcmd đã bị dừng đột ngột. Lần sau, hãy bấm Hủy trong cửa sổ truyền thay vì đóng cưỡng bức, để airnefcmd dọn dẹp cần thiết trước khi thoát."

#: src/airnef/gui.py:512
msgid "No airnefcmd operations have been performed yet."
msgstr "airnefcmd chưa thực hiện thao tác nào."

#: src/airnef/gui.py:518
msgid "Error reading airnefcmd report file \"{:s}\". {:s}"
msgstr "Lỗi khi đọc tệp báo cáo của airnefcmd \"{:s}\". {:s}"

#: src/airnef/gui.py:529
msgid "It appears airnefcmd was uncleanly terminated. In the future please press <ctrl-c> if you'd like to terminate airnefcmd instead of closing its terminal window. This will allow airnefcmd to perform any necessary cleanup prior to exiting."
msgstr "Có vẻ airnefcmd đã bị dừng đột ngột. Lần sau, nếu muốn dừng airnefcmd, hãy nhấn <ctrl-c> thay vì đóng cửa sổ terminal của nó, để airnefcmd dọn dẹp cần thiết trước khi thoát."

#: src/airnef/gui.py:540
msgid "airnef performs its job by launching airnefcmd in a terminal window. By default OSX keeps that terminal window open even after airnefcmd has completed, requiring you to close it manually. You can configure OSX to close the terminal window automatically. Go to the Terminal application and select 'Preferences' in the Terminal menu. Click 'Profiles' at the top and then the \"Shell\" tab in the upper part of the window. Set \"When the shell exits\" option to 'Close if the shell exited cleanly' or 'Close the window'"
msgstr "airnef làm việc bằng cách chạy airnefcmd trong một cửa sổ terminal. Mặc định OSX giữ cửa sổ đó mở cả khi airnefcmd đã xong, nên bạn phải tự đóng. Bạn có thể cấu hình OSX tự đóng cửa sổ: mở ứng dụng Terminal, chọn 'Preferences' trong menu Terminal, bấm 'Profiles' ở trên cùng rồi chọn thẻ \"Shell\". Đặt tùy chọn \"When the shell exits\" thành 'Close if the shell exited cleanly' hoặc 'Close the window'"

