msgstr "airnef tải các ảnh trong danh sách gửi của máy ảnh, rồi xóa chúng khỏi danh sách."

#: src/airnef/gui.py:1021
msgid "On the camera"
msgstr "Trên máy ảnh"

#: src/airnef/gui.py:1023
msgid "Turn your camera on and select which images you'd like to upload. This may be under the camera's WiFi menu as \"Select to send to smart device\" or in the playback menu, depending on the camera model."
msgstr "Bật máy ảnh và chọn các ảnh muốn gửi. Tùy đời máy, tùy chọn này có thể nằm trong menu WiFi (\"Select to send to smart device\") hoặc trong menu xem lại ảnh."

#: src/airnef/gui.py:1025
msgid "Make sure your camera's WiFi is on. The camera may sometimes disable it without direction from the user."
msgstr "Đảm bảo WiFi của máy ảnh đang bật. Đôi khi máy ảnh tự tắt WiFi mà không cần người dùng thao tác."

#: src/airnef/gui.py:1026
msgid "Join your camera's WiFi network on your computer. It will have a name prefixed with \"Nikon\", such as \"Nikon_WU2_0090B6245A45\"."
msgstr "Kết nối máy tính vào mạng WiFi của máy ảnh. Tên mạng bắt đầu bằng \"Nikon\", ví dụ \"Nikon_WU2_0090B6245A45\"."

