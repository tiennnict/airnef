#: airnef.pyw:941
msgid "Start Download"
msgstr "Bắt đầu tải"

#: airnef.pyw:947
msgid "Select folder to download images/movies into"
msgstr "Chọn thư mục để tải ảnh/video vào"

#: airnef.pyw:987
msgid "How would you like to choose which images to download?"
msgstr "Bạn muốn chọn ảnh cần tải theo cách nào?"

#: airnef.pyw:988
msgid "Pick the images on the camera itself, or set criteria such as file type and date on this computer."
msgstr "Chọn ảnh ngay trên máy ảnh, hoặc đặt tiêu chí như loại tệp và ngày chụp trên máy tính này."

#: airnef.pyw:991
msgid "Select in Camera"
msgstr "Chọn trên máy ảnh"

#: airnef.pyw:992
msgid "Download the images you've marked for upload on the camera (Nikon)."
msgstr "Tải các ảnh bạn đã đánh dấu để gửi trên máy ảnh (Nikon)."

#: airnef.pyw:993
msgid "Select on Computer"
msgstr "Chọn trên máy tính"

#: airnef.pyw:994
msgid "Download by file type, capture date, folder and card slot (Nikon, Canon, Sony)."
msgstr "Tải theo loại tệp, ngày chụp, thư mục và khe thẻ (Nikon, Canon, Sony)."

#: airnef.pyw:1012
msgid "Download images you've selected in the camera"
msgstr "Tải các ảnh đã chọn trên máy ảnh"

#: airnef.pyw:1013
msgid "airnef downloads the images on the camera's transfer list, then removes them from the list."
msgstr "airnef tải các ảnh trong danh sách gửi của máy ảnh, rồi xóa chúng khỏi danh sách."

#: airnef.pyw:1020
msgid "On the camera"
msgstr "Trên máy ảnh"

#: airnef.pyw:1022
msgid "Turn your camera on and select which images you'd like to upload. This may be under the camera's WiFi menu as \"Select to send to smart device\" or in the playback menu, depending on the camera model."
msgstr "Bật máy ảnh và chọn các ảnh muốn gửi. Tùy đời máy, tùy chọn này có thể nằm trong menu WiFi (\"Select to send to smart device\") hoặc trong menu xem lại ảnh."

#: airnef.pyw:1024
msgid "Make sure your camera's WiFi is on. The camera may sometimes disable it without direction from the user."
msgstr "Đảm bảo WiFi của máy ảnh đang bật. Đôi khi máy ảnh tự tắt WiFi mà không cần người dùng thao tác."

#: airnef.pyw:1025
msgid "Join your camera's WiFi network on your computer. It will have a name prefixed with \"Nikon\", such as \"Nikon_WU2_0090B6245A45\"."
msgstr "Kết nối máy tính vào mạng WiFi của máy ảnh. Tên mạng bắt đầu bằng \"Nikon\", ví dụ \"Nikon_WU2_0090B6245A45\"."

#: airnef.pyw:1050
