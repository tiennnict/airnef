#: airnef.pyw:915
msgid "The date \"{:s}\" is formatted incorrectly or is not a valid date/time. It must be formatted as mm/dd/yy or mm/dd/yy hh:mm:ss (including leading zeros)."
msgstr "Ngày \"{:s}\" sai định dạng hoặc không phải ngày/giờ hợp lệ. Phải có dạng mm/dd/yy hoặc mm/dd/yy hh:mm:ss (kể cả số 0 ở đầu)."
